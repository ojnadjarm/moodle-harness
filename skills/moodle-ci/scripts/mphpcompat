#!/usr/bin/env bash
# Lint a plugin's *.php with PHPCompatibility against the minimum PHP of its
# $plugin->requires branch.
# Usage: mphpcompat [plugin-dir] [--php X.Y]   (default: $PWD; --php overrides requires)
#   Floor: 4.0 7.3, 4.1 7.4, 4.2/4.3 8.0, 4.4/4.5 8.1, 5.0/5.1 8.2, 5.2/5.3 8.3
#   (same table as mci-workflow). PHPCompatibility 10.x is installed once into
#   ${XDG_CACHE_HOME:-~/.cache}/moodle-harness/phpcompat; runs with MPC's phpcs when present,
#   skips vendor/ and node_modules/. Prints `file:line message`.
# Exit: 1 any error, 0 clean (warnings printed), 2 usage or no version.php, 3 SKIP (no standard or no requires).
set -uo pipefail

die() { echo "mphpcompat: $2" >&2; exit "$1"; }
dir="" php=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) sed -n '2,/^# Exit/s/^# \{0,1\}//p' "$0"; exit 0;;
        --php) [[ "${2:-}" =~ ^[0-9]+\.[0-9]+$ ]] || die 2 "--php needs X.Y"; php="$2"; shift 2;;
        -*) die 2 "unknown option $1";;
        *) [ -z "$dir" ] || die 2 "one plugin dir only"; dir="$1"; shift;;
    esac
done
dir="$(realpath "${dir:-$PWD}")"
[ -f "$dir/version.php" ] || die 2 "no version.php in $dir"

floor() {
    local req; req="$(grep -oP '\$plugin->requires\s*=\s*[\x27"]?\K\d+' "$dir/version.php" | head -1)"
    [ -n "$req" ] || die 3 "SKIP: no \$plugin->requires in $dir/version.php (use --php X.Y)"
    local row out=""
    for row in 2022041900:7.3 2022112800:7.4 2023042400:8.0 2024042200:8.1 2025041400:8.2 2026042000:8.3; do
        [ "$req" -ge "${row%%:*}" ] && out="${row#*:}"
    done
    [ -n "$out" ] || die 2 "requires $req is older than 4.0 (use --php X.Y)"
    echo "$out"
}
[ -n "$php" ] || php="$(floor)" || exit $?

cache="${XDG_CACHE_HOME:-$HOME/.cache}/moodle-harness/phpcompat"
std="$cache/vendor/phpcompatibility/php-compatibility"
if [ ! -d "$std/PHPCompatibility" ]; then
    command -v composer >/dev/null || die 3 "SKIP: composer not found, PHPCompatibility not installed"
    tmp="$cache.tmp.$$"; rm -rf "$tmp"; mkdir -p "$tmp" || die 3 "SKIP: cannot create $tmp"
    if ! (cd "$tmp" && COMPOSER_ALLOW_SUPERUSER=1 composer require -q -n --no-plugins \
            'phpcompatibility/php-compatibility:^10.0@alpha' >"$tmp.log" 2>&1); then
        rm -rf "$tmp"; die 3 "SKIP: composer install of PHPCompatibility failed (log $tmp.log)"
    fi
    rm -rf "$cache" "$tmp.log"; mv "$tmp" "$cache"
fi
phpcs="$HOME/.moodle-plugin-ci/vendor/bin/phpcs"
[ -x "$phpcs" ] || phpcs="$cache/vendor/bin/phpcs"

out="$("$phpcs" -q --report=emacs --extensions=php --basepath="$dir" --ignore='*/vendor/*,*/node_modules/*' \
    --runtime-set installed_paths "$std,$cache/vendor/phpcsstandards/phpcsutils" \
    --standard=PHPCompatibility --runtime-set testVersion "$php-" "$dir")"
rc=$?
[ "$rc" -le 2 ] || die 3 "SKIP: phpcs failed rc $rc: ${out:0:300}"
sed -E 's/^([^:]+):([0-9]+):[0-9]+: error - /\1:\2 /; s/^([^:]+):([0-9]+):[0-9]+: warning - /\1:\2 warning: /' <<<"$out" | grep -v '^$'
errors=$(grep -c ': error - ' <<<"$out")
echo "mphpcompat: PHP $php-: $errors errors, $(grep -c ': warning - ' <<<"$out") warnings"
[ "$errors" -eq 0 ]
