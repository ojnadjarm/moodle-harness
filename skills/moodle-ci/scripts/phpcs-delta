#!/usr/bin/env python3
"""List only the phpcs (moodle standard) violations a change adds, comparing each changed file with its git base."""
import argparse
import collections
import json
import os
import shutil
import subprocess
import sys


def git(repo, *args, check=True):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if check and r.returncode:
        sys.exit(f"phpcs-delta: git {' '.join(args)}: {r.stderr.strip()}")
    return r


def phpcs_bin():
    mpc = os.path.expanduser("~/.moodle-plugin-ci/vendor/bin/phpcs")
    return mpc if os.access(mpc, os.X_OK) else shutil.which("phpcs") or sys.exit("phpcs-delta: no phpcs found")


def violations(phpcs, path, content=None):
    cmd = [phpcs, "--standard=moodle", "--report=json", "-q"]
    cmd += [f"--stdin-path={path}", "-"] if content is not None else [path]
    r = subprocess.run(cmd, input=content, capture_output=True, text=True)
    try:
        files = json.loads(r.stdout)["files"]
    except (ValueError, KeyError):
        sys.exit(f"phpcs-delta: phpcs failed on {path}: {r.stderr.strip() or r.stdout[:300]}")
    return [m for f in files.values() for m in f["messages"]]


def key(m, lines):
    """Match a violation across versions by sniff, message and the text of its line."""
    text = lines[m["line"] - 1].strip() if 0 < m["line"] <= len(lines) else ""
    return m["source"], m["message"], text


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--base", default="HEAD", help="git ref; compared from its merge-base with HEAD (default HEAD)")
    ap.add_argument("paths", nargs="*", default=["."], help="limit to these paths (default: cwd)")
    a = ap.parse_args()
    repo = git(".", "rev-parse", "--show-toplevel").stdout.strip()
    base = git(repo, "merge-base", a.base, "HEAD").stdout.strip()
    paths = [os.path.relpath(os.path.abspath(p), repo) for p in a.paths]
    changed = git(repo, "diff", "--name-only", "--diff-filter=AMR", base, "--", *paths).stdout.split()
    changed += git(repo, "ls-files", "--others", "--exclude-standard", "--", *paths).stdout.split()
    files = sorted({f for f in changed if f.endswith(".php")})
    phpcs = phpcs_bin()
    errors = warnings = 0
    for rel in files:
        full = os.path.join(repo, rel)
        old = git(repo, "show", f"{base}:{rel}", check=False)
        oldlines = old.stdout.splitlines() if old.returncode == 0 else []
        newlines = open(full, errors="replace").read().splitlines()
        before = collections.Counter(key(m, oldlines) for m in (violations(phpcs, full, old.stdout) if oldlines else []))
        for m in violations(phpcs, full):
            k = key(m, newlines)
            if before[k]:
                before[k] -= 1
                continue
            errors += m["type"] == "ERROR"
            warnings += m["type"] == "WARNING"
            print(f"{rel}:{m['line']}:{m['column']} {m['type']} {m['source']} {m['message']}")
    print(f"phpcs-delta: {len(files)} php files vs {base[:10]}: {errors} new errors, {warnings} new warnings")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
