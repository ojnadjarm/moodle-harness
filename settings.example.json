{
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "autoCompactEnabled": true,
  "autoCompactWindow": 300000,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/moodle-session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/moodle-stop-reminder.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/moodle-docs-fetch-deny.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
